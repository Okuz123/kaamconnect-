# ─── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Database (direct connection — for migrations)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres

# ─── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=KaamConnect

# ─── Maps / Geocoding (optional — configure to enable) ────────
NEXT_PUBLIC_MAPS_PROVIDER=openstreetmap
NEXT_PUBLIC_MAPS_API_KEY=

# ─── Payments (Razorpay — configure to enable) ────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
PAYMENT_MODE=sandbox

# ─── Notifications (configure to enable) ──────────────────────
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=

# ─── Storage ──────────────────────────────────────────────────
NEXT_PUBLIC_STORAGE_BUCKET=worker-portfolios
